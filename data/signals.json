 "rules": [
  {
   "id": "stu",
   "text": "Stocks/use percentile versus the prior 10 marketing years. At or below the 33rd percentile is bullish. At or above the 67th is bearish. Otherwise neutral. Percentile is the share of those prior years at or below the current stocks/use. US corn, soybeans, wheat, soybean meal and soybean oil use ending stocks divided by domestic use plus exports. Canola uses the AAFC forecast stocks/use, or USDA Canada if that file is missing. If the latest ending-stocks revision moves the opposite way from the percentile, the cell becomes neutral."
  },
  {
   "id": "mm_extension",
   "text": "Managed money net (long minus short) as a percentile of the last 156 weeks, current week included. At or above the 85th percentile is extended long and the cell reads bearish. At or below the 15th is extended short and the cell reads bullish. Otherwise neutral. Disaggregated managed money only. Leveraged Funds are not used."
  },
  {
   "id": "mm_flow",
   "text": "Change in managed money net over one week and over four weeks. Both up is bullish. Both down is bearish. A mixed pair, or a zero change, is neutral."
  },
  {
   "id": "seasonal",
   "text": "Average of the Peak Trading Research weekly scores for the current week and the next four weeks. Scores run from \u22125 to +5. An average of 1 or higher is bullish. An average of -1 or lower is bearish. Otherwise neutral. The same scores are reused every year, keyed by calendar week, and a late-December window continues into January. They are typed on the Seasonals page, not fetched, and they do not expire. A market with no typed score is a dash. Peak Trading Research seasonal, last reviewed 2026-10-24."
  },
  {
   "id": "score",
   "text": "A bullish cell is +1, a bearish cell is \u22121, and a neutral cell is 0. Dashes are left out. A row or section total of +2 or higher is Supportive. -2 or lower is Bearish. Anything between is Neutral."
  },
  {
   "id": "demand_pace",
   "text": "US export commitments as a percent of the USDA export forecast, minus the 5-year average of that percent at the same week. At least +3 percentage points ahead is bullish. At least 3 behind is bearish. The saved export history does not cover those earlier seasons, so the cell is a dash. Canola uses CGC crop-year exports versus the same week a year ago. At least +3% is bullish and at least 3% behind is bearish."
  },
  {
   "id": "condition",
   "text": "NASS good/excellent minus the printed 5-year average, or minus year ago when the average is not printed. At least 3 points below is bullish. At least 3 points above is bearish. Outside the months listed in the config the cell says out of season. Meal and oil have no condition series."
  },
  {
   "id": "energy_level",
   "text": "Stocks versus the 5-year average. At least +3% is bearish. At least 3% below is bullish. Natural gas uses the WNGSR published percent. Petroleum uses the percent computed from weekly levels."
  },
  {
   "id": "energy_change",
   "text": "This week's percent stock change minus the average percent change in the same week of the prior five years. At least +3 percentage points (a heavier build or a lighter draw) is bearish. At least 3 the other way is bullish."
  },
  {
   "id": "cattle_yoy",
   "text": "Cattle on Feed printed percent of a year ago. At or below 98 is bullish. At or above 102 is bearish. The same thresholds are used for placements. Both cattle rows use this one report."
  },
  {
   "id": "cutout",
   "text": "Choice boxed beef from the USDA AMS boxed-beef report, over four weeks. Up more than 1% is bullish, down more than that is bearish, inside the band is neutral. This is the printed AMS cutout, not a futures price. The cattle file has one print, so the cell is a dash. Slaughter pace is omitted because the AMS report does not print a year-ago head count."
  },
  {
   "id": "staleness",
   "text": "A cell whose as-of date is older than its cadence is a dash. Cadences, in days: wasde 45, aafc 45, cftc 14, exports 14, cgc 14, energy 14, crop 21, cattle 45."
  }
 ],
